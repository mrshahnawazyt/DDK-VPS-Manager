# Example only: save this as /etc/systemd/system/ddk-vps-manager-python-proxy.service
# after you have reviewed and installed your own Python application.
[Unit]
Description=DDK VPS Manager optional Python proxy integration
After=network.target

[Service]
Type=simple
EnvironmentFile=/opt/ddk-vps-manager/data/python-proxy.env
# Replace this command with the path and safe arguments for your own service.
# ExecStart=/usr/bin/python3 /opt/your-python-service/app.py --port ${DDK_VPS_MANAGER_PROXY_PORT}
Restart=on-failure

[Install]
WantedBy=multi-user.target
