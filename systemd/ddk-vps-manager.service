[Unit]
Description=DDK VPS Manager server management panel
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ddk-vps-manager
ExecStart=/usr/bin/python3 /opt/ddk-vps-manager/app.py --serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/opt/ddk-vps-manager

[Install]
WantedBy=multi-user.target
